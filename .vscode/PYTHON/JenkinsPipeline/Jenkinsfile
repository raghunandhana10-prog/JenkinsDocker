
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo 'Code downloaded from GitHub'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t myapp .'
            }
        }

        stage('Run Docker Container') {
            steps {
                bat 'docker run --rm myapp'
            }
        }
    }

    post {
        success {
            echo 'Git Jenkins Docker Pipeline Successful!'
        }

        failure {
            echo 'Pipeline Failed!'
        }
    }
}
